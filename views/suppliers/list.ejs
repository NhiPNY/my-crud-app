<%- include("../layout", { title: "Suppliers", body: `
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Suppliers</h2>
    <a href="/suppliers/create" class="btn btn-primary">+ Add Supplier</a>
  </div>

  <table class="table table-striped">
    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Address</th>
        <th>Phone</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% suppliers.forEach(s => { %>
        <tr>
          <td><%= s.name %></td>
          <td><%= s.address %></td>
          <td><%= s.phone %></td>
          <td>
            <a href="/suppliers/edit/<%= s._id %>" class="btn btn-sm btn-warning">Edit</a>
            <a href="/suppliers/delete/<%= s._id %>" class="btn btn-sm btn-danger"
               onclick="return confirm('Are you sure?')">Delete</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
` }) %>
